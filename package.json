{
  "name": "kashi-extension",
  "private": true,
  "description": "Local lyric conversion for Spotify Web and desktop",
  "version": "2026.1105.0",
  "author": "Cristian-SknZ",
  "homepage": "https://github.com/Cristian-Sknz/kashi-extension",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Cristian-Sknz/kashi-extension.git",
    "type": "git"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:web": "bun scripts/build.ts web",
    "build:desktop": "bun scripts/build.ts desktop",
    "watch:web": "bun scripts/build.ts web --watch",
    "watch": "bun run watch:web",
    "package": "bun scripts/package.ts",
    "check:package": "bun scripts/check-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fflate": "0.8.3",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "cyrillic-to-translit-js": "3.2.1",
    "es-hangul": "2.4.0",
    "kuromoji": "0.1.2",
    "kuroshiro": "1.2.1",
    "kuroshiro-analyzer-kuromoji": "1.1.0",
    "pinyin-pro": "3.29.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
